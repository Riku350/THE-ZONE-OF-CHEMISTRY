# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Razorpay Credentials for Online Fee Payment Verification
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Cashfree Payment Gateway Credentials (Server-Side Only — Never expose Secret Key to client)
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
CASHFREE_ENV="sandbox"

# Optional First-Time Super Admin Setup Key for programmatic Email/Password bootstrap
# Note: godrikuop@gmail.com can also sign in directly via verified Google Sign-In
ADMIN_SETUP_KEY=""
